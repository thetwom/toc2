<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the track list: note preview, volume slider, mute, focus and delete. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="8dp"
    android:paddingRight="8dp">

    <LinearLayout
        android:id="@+id/track_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/track_index"
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            tools:ignore="HardcodedText"
            android:text="1" />

        <de.moekadu.metronome.views.TrackPreviewView
            android:id="@+id/track_preview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingLeft="2dp"
            android:paddingRight="2dp" />

        <SeekBar
            android:id="@+id/track_volume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:paddingLeft="4dp"
            android:paddingRight="4dp" />

        <ImageButton
            android:id="@+id/track_mute"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_action_mute"
            android:contentDescription="@string/mute" />

        <ImageButton
            android:id="@+id/track_focus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_focus_off"
            android:contentDescription="@string/track_focus" />

        <ImageButton
            android:id="@+id/track_delete"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_small"
            android:contentDescription="@string/delete_track" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/new_track_button"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/new_track"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone" />
</FrameLayout>
